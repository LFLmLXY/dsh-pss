{
  "name": "dsh-pss",
  "version": "0.2.0",
  "description": "Parametric Session State (PSS) for DeepSeek Harness — O(1) session storage, LoRA-compiled retrieval intent, and a live neural-graph dashboard that shows the model's memory flow.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manager": {
      "types": "./dist/PSSManager.d.ts",
      "default": "./dist/PSSManager.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dashboard",
    "knowledge",
    "python_backend",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "session-state",
    "lora",
    "rag",
    "dashboard",
    "cytoscape",
    "pss"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run build && node tool/dev-server.mjs",
    "smoke": "node tool/smoke.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  }
}
